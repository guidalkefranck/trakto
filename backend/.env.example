# Copie este arquivo para backend/.env e preencha com os SEUS valores.
# backend/.env está no .gitignore: nunca envie senhas reais para o Git.

# Porta em que a API vai rodar
PORT=3000

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trakto

# Senha usada pelo script `npm run db:popular` nas contas de demonstração
# (mínimo 8 caracteres). Ela é gravada no banco apenas como hash bcrypt.
SENHA_DEMO=trakto123
