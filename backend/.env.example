# Copie este arquivo para backend/.env e preencha com os SEUS valores.
# backend/.env está no .gitignore: nunca envie senhas reais para o Git.

# Porta em que a API vai rodar
PORT=3000

# Conexão com o MySQL
# Use 127.0.0.1 (e não localhost): no Windows o Node tenta IPv6 (::1) e o MySQL costuma ouvir só IPv4.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trakto

# Segredo que assina os tokens JWT. Use um texto longo e aleatório (mínimo 32 caracteres).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres

# Validade do token (ex.: 8h, 1d). Depois disso o usuário precisa entrar de novo.
JWT_EXPIRA_EM=8h

# Senha usada pelo script `npm run db:popular` nas contas de demonstração
# (mínimo 8 caracteres). Ela é gravada no banco apenas como hash bcrypt.
SENHA_DEMO=trakto123
