# Endereço da API usado pelo app (Expo lê variáveis EXPO_PUBLIC_*).
# Copie para .env na raiz do projeto.
#  - Navegador (w) no mesmo computador: http://localhost:3000
#  - Celular com Expo Go: use o IP do computador na rede Wi-Fi,
#    por exemplo http://192.168.0.15:3000 (veja com o comando ipconfig)
EXPO_PUBLIC_API_URL=http://localhost:3000
